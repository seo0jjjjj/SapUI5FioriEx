<core:FragmentDefinition xmlns:core="sap.ui.core" 
        xmlns="sap.m">
    <Dialog id="idDialog"
            title="Class ValueHelp"
            contentWidth="100px"
            contentHeight="400px"
            draggable="true"
            resizable="true">
        <content>
            <Table id="idClassTable" selectionChange="onDialogSelect" 
            mode="SingleSelectMaster" items="{class>/datas}">
                <columns>
                    <Column><Text text="학급" /></Column>
                    <Column><Text text="학급 이름" /></Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{class>code}" />
                            <Text text="{class>text}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <endButton>
            <Button text="닫기" press=".onClose" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>